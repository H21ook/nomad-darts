# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# serwist generated service worker (regenerated by `pnpm build` per-platform)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.serena

# OPENCODE_STATEFUL_WORKFLOW_START
# OpenCode active workflow runtime artifacts
.opencode/workflows/*
!.opencode/workflows/.gitkeep

# High-risk workflow archives may contain detailed agent/tool output.
.opencode/archive/*
!.opencode/archive/.gitkeep
# OPENCODE_STATEFUL_WORKFLOW_END
